# Persistance. Sans ces variables, Atelier écrit dans .atelier-data/ (développement).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dossier des données en mode fichier (optionnel)
# ATELIER_DATA_DIR=

# Formulaires (D47) : notification par email via Resend. Sans clé, les envois sont seulement enregistrés (onglet Données → Messages reçus).
RESEND_API_KEY=
FORM_NOTIFY_TO=
# MAIL_FROM="Atelier <onboarding@resend.dev>"

# Publication (M6) : domaine sous lequel les sites publiés répondent, en <sous-domaine>.<domaine>. Il doit être DIFFÉRENT du domaine de l'éditeur (sécurité : le code injecté d'un site ne doit jamais partager l'origine de l'éditeur). Sans valeur : localhost:3000 (marie.localhost:3000 fonctionne dans Chrome).
ATELIER_SITES_DOMAIN=
# Le repli /s/<sous-domaine>/ sur le domaine de l'éditeur n'existe qu'en développement ; ATELIER_ALLOW_PATH_FALLBACK=1 le force (jamais avec des sites de clients).
# ATELIER_ALLOW_PATH_FALLBACK=

# Comptes (D50, première version) : connexion par lien magique avec Supabase Auth. Sans ces deux variables : accès libre (développement).
# Project Settings → API : « Project URL » et la clé publique « anon ». Puis Authentication → URL Configuration : Site URL et Redirect URLs (…/auth/callback).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Adresses autorisées à se connecter, séparées par des virgules (vide : toutes)
ATELIER_ALLOWED_EMAILS=
# ATELIER_AUTH=off force l'accès libre même avec les clés publiques (second serveur d'essai)
